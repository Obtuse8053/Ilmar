#
# Agent sandbox image for ClaudeCodeRunner (ADR-0011 §6, ADR-0017).
#
# Build it yourself, under Anthropic's terms for Claude Code; Ilmar never
# distributes Claude Code or images containing it (MANIFEST §7.5). Do not push
# the result to a public registry.
#
#   podman build --build-arg CLAUDE_CODE_VERSION=<x.y.z> \
#       -t localhost/ilmar-claude-code:<x.y.z> images/claude-code
#
# The version is required and pinned: nothing is installed or updated at run
# time, and ClaudeCodeSettings(expected_version=...) can check it.

# Pinned by digest (the multi-platform index of node:22-bookworm-slim, 2026-11-05):
# a rebuild uses exactly this base. Update the digest deliberately, in a reviewed
# change; CI pulls it to prove it resolves.
FROM docker.io/library/node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d

ARG CLAUDE_CODE_VERSION
RUN test -n "${CLAUDE_CODE_VERSION}" \
    || (echo "set --build-arg CLAUDE_CODE_VERSION=<x.y.z>" >&2 && exit 1)

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git ripgrep python3 \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force \
    && claude --version

# The node image's user 1000 matches the sandbox user (ADR-0014).
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_AUTOUPDATER=1
USER 1000:1000
WORKDIR /workspace
